--- !u!114 &1026653473
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1026653472}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70eae2f2a4a2a8248b9e5e1002099026, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CelesteDialogueSystem
  panel: {fileID: 1418016743}
  dialogueText: {fileID: 244316306}
  portraitImage: {fileID: 2061024920}
  madelineSprite: {fileID: 2145454608, guid: 36919f14cc04538429b9ae8cba3dd801, type: 3}
  grannySprite: {fileID: 821144322, guid: a9bbeca08e327c245b06a3c7e2cf96a8, type: 3}
  audioSource: {fileID: 1026653475}
  basePitch: 1
  gameplayCam: {fileID: 1621862279}
  cutsceneCam: {fileID: 761030326}
  player: {fileID: 1759503103}
  lines:
  - speaker: Madeline
    text: Excuse me, ma'am?
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: Madeline
    text: The sign out front is busted... is this the Mountain trail?
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: OldLady
    text: You're almost there. It's just across the bridge.
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: Madeline
    text: By the way, you should call someone about your driveway. The ridge collapsed
      and I nearly died.
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: OldLady
    text: If my 'driveway' almost did you in, the Mountain might be a bit much for
      you.
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: Madeline
    text: ...
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: Madeline
    text: Well, if an old bat like you can survive out here, I think I'll be fine.
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: OldLady
    text: '[Laughs]'
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
  - speaker: OldLady
    text: Good luck, then. You'll need it.
    preDelay: 0.5
    typeSpeed: 0.03
    postDelay: 1
